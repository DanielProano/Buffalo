with "config/buffalo_config.gpr";
project Buffalo is
   for Languages use ("Ada", "C");

   -- Target uses the string as "arm-eabi*"
   -- within the toolchain 
   for Target use "arm-eabi";
   for Runtime ("Ada") use "light-cortex-m4f";
   for Source_Dirs use ("src/", "src/bindings", "src/bootloader", "src/crypto", "src/hal", "src/hal/stm32", "config/", "lib/monocypher/");
   for Object_Dir use "obj/" & Buffalo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "build";
   for Main use ("buffalo.adb");

   package Compiler is
      for Default_Switches ("Ada") use Buffalo_Config.Ada_Compiler_Switches;
   end Compiler;

   package Linker is
      -- -T tells compiler to use linker script
      -- instead of using default memory layout
      for Default_Switches ("Ada") use ("-T", Project'Project_Dir & "linker/stm32f401.ld");
   end Linker;

end Buffalo;
